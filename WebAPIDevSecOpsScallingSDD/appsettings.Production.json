{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": false,
  "Kestrel": { "Limits": { "MaxRequestBodySize": 10485760, "KeepAliveTimeout": "00:02:00" } },
  "Cors": { "AllowedOrigins": [ "https://yourproductiondomain.com" ] },
  "AssemblyIntegrity": { "ExpectedSha256": "" },
  "Redis": { "ConnectionString": "localhost:6379,abortConnect=false" }
}
