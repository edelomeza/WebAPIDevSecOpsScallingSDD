{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://yourproductiondomain.com" ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  }
}
